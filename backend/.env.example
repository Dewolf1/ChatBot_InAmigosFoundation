# Copy this file to .env and fill in real values before deploying.
# (The app runs fine with none of these set — it just uses the offline stub
# reply for anything the FAQ layer can't confidently answer.)

# --- LLM fallback (pick ONE provider) ---
LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Org info used in the LLM system prompt ---
ORG_NAME=InAmigos Foundation
ORG_CONTACT_EMAIL=support@inamigosfoundation.org.in

# --- Admin endpoint (view queries the bot couldn't answer) ---
# Leave blank to disable the /admin/unanswered route entirely.
ADMIN_KEY=
